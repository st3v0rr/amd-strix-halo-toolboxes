# Copy to .env and provide the referenced mode-0600 secret file. The service
# refuses to start while the file is missing or the fallback key is a placeholder.
#
# Prefer rootless Podman secrets or mode-0600 files over values in .env:
MEDIA_API_KEY_FILE=/run/secrets/media-api-key
# MEDIA_SESSION_SECRET_FILE=/run/secrets/media-api-session
# Generate either file with: umask 077; python3 -c 'import secrets; print(secrets.token_urlsafe(32))' > FILE
# Less-safe fallback (do not set both the value and file forms):
# MEDIA_API_KEY=replace-with-a-long-random-key
# Optional; derived from MEDIA_API_KEY when unset (rotating the key then ends all sessions).
# MEDIA_SESSION_SECRET=replace-with-a-different-long-random-secret

MEDIA_BACKEND=real
# Safe direct-run default. A container may listen on 0.0.0.0 internally while
# publishing only to 127.0.0.1 on the host.
MEDIA_HOST=127.0.0.1
MEDIA_PORT=8000
MEDIA_MODELS_DIR=/models
MEDIA_OUTPUT_DIR=/data/outputs
MEDIA_UPLOAD_DIR=/data/uploads
MEDIA_STATE_DIR=/data/state
# MEDIA_CONFIG=/config/media-api.yaml

# Hugging Face: nothing is downloaded unless this is 1 (or media-api-models fetch is run).
MEDIA_ALLOW_DOWNLOADS=0
# HF_TOKEN=

# Limits (defaults shown)
# MEDIA_MAX_UPLOAD_BYTES=20971520
# MEDIA_MAX_ENCODED_UPLOAD_BYTES=41943040
# MEDIA_MAX_UPLOAD_COUNT=1000
# MEDIA_MAX_TOTAL_UPLOAD_BYTES=2147483648
# MEDIA_MIN_FREE_DISK_BYTES=1073741824
# MEDIA_MAX_QUEUED_JOBS=16
# MEDIA_MAX_PROMPT_CHARS=8000
# MEDIA_MAX_WIDTH=2048
# MEDIA_MAX_HEIGHT=2048
# MEDIA_MAX_FRAMES=345
# MEDIA_MAX_STEPS=100
# MEDIA_RESULT_TTL_HOURS=72
# MEDIA_MAX_RETAINED_JOBS=500
# MEDIA_MEMORY_CHECK=strict
# MEDIA_MEMORY_RESERVE_GB=8
# Keep 0 only for localhost HTTP. Remote access requires TLS and this must be 1.
# MEDIA_COOKIE_SECURE=0
# MEDIA_CORS_ORIGINS=
