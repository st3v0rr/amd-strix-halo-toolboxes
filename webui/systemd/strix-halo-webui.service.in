[Unit]
Description=Strix Halo Toolboxes Web UI
Documentation=file://%REPO_WEBUI%/README.md
# For a --user unit this is default.target; for a system unit,
# network-online.target. The app retries network-dependent work (registry
# checks) either way, so it never blocks startup on connectivity.
After=%AFTER%

[Service]
Type=simple
WorkingDirectory=%REPO_WEBUI%
Environment=NODE_ENV=production
Environment=HOME=%SERVICE_HOME%
# Tells the self-updater whether systemd-run and systemctl need --user.
Environment=SHX_SYSTEMD_SCOPE=%SCOPE%
Environment=SHX_CONFIG_DIR=%CONFIG_DIR%
Environment=SHX_STATE_DIR=%STATE_DIR%
EnvironmentFile=-%CONFIG_DIR%/env
ExecStart=%NODE_BIN% server/src/index.js
Restart=always
RestartSec=3
# KillMode=mixed is what lets the self-updater survive: only the main process
# gets SIGTERM on restart, so a child still running `npm ci` is not killed
# along with it.
KillMode=mixed
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal
SyslogIdentifier=strix-halo-webui

[Install]
WantedBy=%WANTED_BY%
